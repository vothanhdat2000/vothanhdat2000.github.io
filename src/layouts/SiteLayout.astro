---
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/polish.css';
interface Props { title?: string; description?: string; path?: string }
const { title = 'Vo Thanh Dat — DevOps & SRE', description = 'Cloud infrastructure, incident response and delivery automation. Building toward Platform Engineering.', path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/images/og-banner.jpg', Astro.site)} /><meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect x='8.25' y='.75' width='15' height='4.5' rx='2.25' fill='%23d749a4'/%3E%3Crect x='6' y='6.75' width='15' height='4.5' rx='2.25' fill='%23f2ab35'/%3E%3Crect x='3.75' y='12.75' width='15' height='4.5' rx='2.25' fill='%2312b382'/%3E%3Crect x='1.5' y='18.75' width='15' height='4.5' rx='2.25' fill='%233186e9'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script is:inline src="/scripts/boot.js"></script><script is:inline src="/scripts/site.js" defer></script>
</head>
<body><script is:inline src="/scripts/icons.js"></script><slot /><div class="toast" role="status"><svg class="i" aria-hidden="true"><use href="#i-check" /></svg><span data-toast-text></span></div></body>
</html>
