---
const home = Astro.url.pathname === '/';
const section = (id: string) => `${home ? '' : '/'}#${id}`;
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="wordmark" href={section('top')}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect class="m1" x="8.25" y="0.75" width="15" height="4.5" rx="2.25"/><rect class="m2" x="6" y="6.75" width="15" height="4.5" rx="2.25"/><rect class="m3" x="3.75" y="12.75" width="15" height="4.5" rx="2.25"/><rect class="m4" x="1.5" y="18.75" width="15" height="4.5" rx="2.25"/></svg>
      <span>Vo Thanh Dat</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        <li><a href={section('experience')} data-nav>Experience</a></li>
        
        <li><a href={section('areas')} data-nav>Technical stack</a></li>
        <li><a href={section('education')} data-nav>Education</a></li>
        <li><a href={section('contact')} data-nav>Contact</a></li>
      </ul>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
    <div class="header-actions">
      
      <button class="icon-button" type="button" data-theme-toggle aria-label="Switch to light theme">
        <svg class="i theme-moon" aria-hidden="true"><use href="#i-moon"/></svg>
        <svg class="i theme-sun" aria-hidden="true"><use href="#i-sun"/></svg>
      </button>
      <button class="icon-button menu-button" type="button" data-menu-open aria-haspopup="dialog" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg class="i" aria-hidden="true"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>
</header>
<dialog class="menu-dialog" id="mobile-menu" aria-label="Menu">
  <div class="menu-top">
    <a class="wordmark" href={section('top')}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect class="m1" x="8.25" y="0.75" width="15" height="4.5" rx="2.25"/><rect class="m2" x="6" y="6.75" width="15" height="4.5" rx="2.25"/><rect class="m3" x="3.75" y="12.75" width="15" height="4.5" rx="2.25"/><rect class="m4" x="1.5" y="18.75" width="15" height="4.5" rx="2.25"/></svg>
      <span>Vo Thanh Dat</span>
    </a>
    <button class="icon-button" type="button" data-menu-close aria-label="Close menu" autofocus><svg class="i" aria-hidden="true"><use href="#i-close"/></svg></button>
  </div>
  <nav aria-label="Mobile">
    <ol class="menu-links">
      <li style="--i:0"><a href={section('experience')}><span>Experience</span><span class="num">01</span></a></li>
      
      <li style="--i:2"><a href={section('areas')}><span>Technical stack</span><span class="num">02</span></a></li>
      <li style="--i:3"><a href={section('education')}><span>Education & credentials</span><span class="num">03</span></a></li><li style="--i:4"><a href={section('contact')}><span>Contact</span><span class="num">04</span></a></li>
      <li style="--i:5"><a href="/how-this-site-is-built/"><span>How this site is built</span><span class="num">↗</span></a></li>
    </ol>
  </nav>
  <div class="menu-foot">
    <a class="button button-primary" href={section('contact')}>Get in touch</a>
    <button class="button button-secondary" type="button" data-theme-toggle aria-label="Switch to light theme">
      <svg class="i theme-moon" aria-hidden="true"><use href="#i-moon"/></svg><svg class="i theme-sun" aria-hidden="true"><use href="#i-sun"/></svg><span data-theme-label>Light theme</span>
    </button>
  </div>
</dialog>
